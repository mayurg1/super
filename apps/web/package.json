{
  "name": "@supercampus/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @supercampus/contracts build && pnpm --filter @supercampus/core build && pnpm --filter @supercampus/api-client build && pnpm --filter @supercampus/shared build && pnpm --filter @supercampus/supabase build && tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supercampus/api-client": "workspace:*",
    "@supercampus/contracts": "workspace:*",
    "@supercampus/core": "workspace:*",
    "@supercampus/shared": "workspace:*",
    "@supercampus/supabase": "workspace:*",
    "@tanstack/react-query": "^5.80.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
